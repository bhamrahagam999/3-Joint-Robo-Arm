#include <Servo.h>
Servo jointServo;
Servo shoulderServo;
Servo clawServo;

int homeButton = 2;
  
void setup() {
  jointServo.attach(9);
  shoulderServo.attach(10);
  clawServo.attach(11);
  
  pinMode(homeButton,INPUT_PULLUP);
}

void loop() {
  
  if (digitalRead(homeButton) == LOW) {
    jointServo.write(90);
    shoulderServo.write(90);
    clawServo.write(0);
    
    delay(200);
    return;
  }
  
  int pot1 = analogRead(A0);
  int pot2 = analogRead(A1);
  int pot3 = analogRead(A2);

 
  int jointAngle = map(pot1, 0, 1023, 20, 160);
  int shoulderAngle = map(pot2, 0, 1023, 40, 140);
  int clawAngle = map(pot3, 0, 1023, 20, 90);

  jointServo.write(jointAngle);
  shoulderServo.write(shoulderAngle);
  clawServo.write(clawAngle);
  
}
